# Server
NODE_ENV=development
PORT=5000

# Database — NeonDB PostgreSQL connection string
DATABASE_URL=postgresql://neondb_owner:npg_W9bNIsrtK4Yv@ep-dry-credit-aqjrtscl.c-8.us-east-1.aws.neon.tech/neondb?sslmode=require

# JWT
JWT_SECRET=your_super_secret_jwt_key_minimum_32_chars
